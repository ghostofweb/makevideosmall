{
  "name": "make-video-small",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Video and image compression studio built with Tauri, Rust and React",
  "author": "Sahiljeet Singh Kalsi (GhostofWeb)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghostofweb/makevideosmall.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "tsc -b && vite build",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "fetch-ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "playwright-core": "^1.50.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.0"
  }
}
